@model List<EMart.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";
}

@section Styles {

    <style>

        body {
            background: #f8f9fa;
        }

        .product-card {
            transition: .3s;
            border-radius: 20px;
        }

            .product-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 15px 40px rgba(0,0,0,.12) !important;
            }

        .card {
            border-radius: 20px;
        }

        .card-header {
            border-radius: 20px 20px 0 0 !important;
        }

        .btn {
            border-radius: 10px;
        }

        .form-control {
            border-radius: 10px;
        }

        .input-group .btn {
            border-radius: 0 10px 10px 0;
        }

        img {
            transition: .3s;
        }

            img:hover {
                transform: scale(1.05);
            }

        .badge {
            font-size: .75rem;
        }

        h2, h3, h4, h5 {
            font-weight: 700;
        }

        @@media (max-width: 991px) {

            .sticky-top {
                position: relative !important;
                top: 0 !important;
            }
        }

        @@media (max-width: 768px) {

            .product-card .row > div {
                text-align: center;
                margin-bottom: 20px;
            }

            .product-card .text-end {
                text-align: center !important;
            }
        }

    </style>

}

<div class="container py-5">

    <!-- Page Heading -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">

                <i class="bi bi-cart3 text-primary"></i>

                Shopping Cart

            </h2>

            <p class="text-muted mb-0">

                @Model.Count Item(s) in your cart

            </p>

        </div>

        <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-outline-primary">

            <i class="bi bi-arrow-left"></i>

            Continue Shopping

        </a>

    </div>

    <div class="row">

        <!-- ========================= -->
        <!-- Left Side -->
        <!-- ========================= -->

        <div class="col-lg-8">

            @if (Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="card border-0 shadow-sm rounded-4 mb-4 product-card">

                        <div class="card-body">

                            <div class="row align-items-center">

                                <!-- Product Image -->

                                <div class="col-md-3 text-center">

                                    <img src="@item.ThumbnailImage"
                                         class="img-fluid rounded-3 border p-2 bg-white"
                                         style="height:160px;
                                    width:160px;
                                    object-fit:contain;" />

                                </div>

                                <!-- Product Details -->

                                <div class="col-md-5">

                                    <h5 class="fw-bold mb-2">

                                        @item.ProductName

                                    </h5>

                                    <div class="mb-2">

                                        <span class="badge bg-success">

                                            In Stock

                                        </span>

                                    </div>

                                    <p class="text-muted small mb-1">

                                        Free Delivery Available

                                    </p>

                                    <p class="text-muted small mb-0">

                                        7 Days Replacement Policy

                                    </p>

                                </div>

                                <!-- Price & Quantity -->

                                <div class="col-md-4">

                                    <div class="text-end">

                                        <h4 class="text-primary fw-bold">

                                            ₹@item.Price.ToString("N2")

                                        </h4>

                                    </div>

                                    <form asp-action="UpdateQuantity"
                                          asp-controller="Cart"
                                          method="post">

                                        <input type="hidden"
                                               name="cartId"
                                               value="@item.CartId" />

                                        <label class="form-label fw-semibold mt-3">

                                            Quantity

                                        </label>

                                        <div class="input-group">

                                            <input type="number"
                                                   name="quantity"
                                                   value="@item.Quantity"
                                                   min="1"
                                                   class="form-control text-center" />

                                            <button class="btn btn-primary">

                                                Update

                                            </button>

                                        </div>

                                    </form>

                                    <div class="mt-3 d-flex justify-content-between">

                                        <span class="fw-semibold">

                                            Total

                                        </span>

                                        <span class="fw-bold text-success">

                                            ₹@item.Total.ToString("N2")

                                        </span>

                                    </div>

                                    <div class="mt-3 text-end">

                                        <a asp-action="Remove"
                                               asp-route-cartId="@item.CartId"
                                               class="btn btn-outline-danger btn-sm">

                                            <i class="bi bi-trash"></i>

                                            Remove

                                        </a>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="card border-0 shadow rounded-4">

                    <div class="card-body text-center py-5">

                        <i class="bi bi-cart-x display-1 text-secondary"></i>

                        <h3 class="mt-4">

                            Your Shopping Cart is Empty

                        </h3>

                        <p class="text-muted">

                            Looks like you haven't added any products yet.

                        </p>

                        <a asp-controller="Home"
                               asp-action="Index"
                               class="btn btn-primary px-4">

                            Start Shopping

                        </a>

                    </div>

                </div>
            }

        </div>

        <!-- ========================= -->
        <!-- Right Side -->
        <!-- Order Summary -->
        <!-- Continue in Part 2 -->
        <!-- ========================= -->

        <div class="col-lg-4">
            @if (Model.Any())
            {
                var subtotal = Model.Sum(x => x.Total);
                decimal shipping = 0;
                decimal discount = 0;
                decimal grandTotal = subtotal + shipping - discount;

                <div class="card border-0 shadow-sm rounded-4 sticky-top"
                     style="top:100px;">

                    <div class="card-header bg-primary text-white rounded-top-4">

                        <h4 class="mb-0">

                            <i class="bi bi-receipt"></i>

                            Order Summary

                        </h4>

                    </div>

                    <div class="card-body">

                        <div class="d-flex justify-content-between mb-3">

                            <span>

                                Subtotal

                            </span>

                            <strong>

                                ₹@subtotal.ToString("N2")

                            </strong>

                        </div>

                        <div class="d-flex justify-content-between mb-3">

                            <span>

                                Shipping

                            </span>

                            <span class="text-success">

                                FREE

                            </span>

                        </div>

                        <div class="d-flex justify-content-between mb-3">

                            <span>

                                Discount

                            </span>

                            <span class="text-danger">

                                ₹@discount.ToString("N2")

                            </span>

                        </div>

                        <hr />

                        <div class="d-flex justify-content-between align-items-center mb-4">

                            <h5 class="mb-0">

                                Grand Total

                            </h5>

                            <h4 class="text-primary fw-bold mb-0">

                                ₹@grandTotal.ToString("N2")

                            </h4>

                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-semibold">

                                Apply Coupon

                            </label>

                            <div class="input-group">

                                <input type="text"
                                       class="form-control"
                                       placeholder="Coupon Code" />

                                <button class="btn btn-outline-primary">

                                    Apply

                                </button>

                            </div>

                        </div>

                        <div class="d-grid gap-2">

                            <a asp-controller="Checkout"
                                   asp-action="Index"
                                   class="btn btn-success btn-lg">

                                <i class="bi bi-credit-card me-2"></i>

                                Proceed to Checkout

                            </a>

                            <a asp-controller="Home"
                                   asp-action="Index"
                                   class="btn btn-outline-primary">

                                Continue Shopping

                            </a>

                            <a asp-action="ClearCart"
                                   class="btn btn-outline-danger">

                                <i class="bi bi-trash"></i>

                                Clear Cart

                            </a>

                        </div>

                        <hr />

                        <div>

                            <div class="mb-2">

                                <i class="bi bi-shield-check text-success"></i>

                                Secure Payment

                            </div>

                            <div class="mb-2">

                                <i class="bi bi-arrow-repeat text-primary"></i>

                                Easy Returns

                            </div>

                            <div class="mb-2">

                                <i class="bi bi-truck text-warning"></i>

                                Free Shipping

                            </div>

                            <div>

                                <i class="bi bi-patch-check text-success"></i>

                                Genuine Products

                            </div>

                        </div>

                    </div>

                </div>
            }
        </div>

        
    </div>

</div>
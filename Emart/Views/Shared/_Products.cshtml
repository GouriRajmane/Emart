@model EMart.ViewModels.PagedResult<EMart.Models.Products>

@{
    ViewData["Title"] = "All Products";
}

<div class="container py-5">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row
        justify-content-between align-items-md-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                All Products
            </h2>

            <p class="text-muted mb-0">
                Explore our latest collection
            </p>
        </div>

    </div>


    <!-- Search -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">

            <form asp-controller="Products"
                  asp-action="Index"
                  method="get">

                <div class="row g-2">

                    <div class="col-md-10">

                        <input type="text"
                               name="searchText"
                               value="@Model.SearchText"
                               class="form-control"
                               placeholder="Search products..." />

                    </div>

                    <div class="col-md-2">

                        <button type="submit"
                                class="btn btn-primary w-100">

                            <i class="bi bi-search me-1"></i>
                            Search

                        </button>

                    </div>

                </div>

            </form>

        </div>
    </div>


    <!-- Products -->
    <div class="row g-4">

        @if (Model.Items != null && Model.Items.Any())
        {
            @foreach (var product in Model.Items)
            {
                <div class="col-6 col-md-4 col-lg-3">

                    <div class="card h-100 border-0 shadow-sm product-card">

                        <!-- Product Image -->
                        <div class="position-relative">

                            <a asp-controller="Products"
                                   asp-action="Details"
                                   asp-route-id="@product.ProductId"
                                   class="text-decoration-none">

                                <img src="@(string.IsNullOrEmpty(product.ThumbnailImage)
                                                                ? "/images/no-image.png"
                                                                : product.ThumbnailImage)"
                                     class="card-img-top product-image"
                                     alt="@product.ProductName" />

                            </a>

                            @if (product.IsActive)
                            {
                                <span class="badge bg-success
                                    position-absolute top-0 end-0 m-2">
                                    Available
                                </span>
                            }

                        </div>


                        <!-- Product Details -->
                        <div class="card-body d-flex flex-column">

                            <h6 class="fw-semibold text-truncate"
                                title="@product.ProductName">

                                @product.ProductName

                            </h6>


                            <small class="text-muted mb-2">
                                SKU : @product.SKU
                            </small>


                            <!-- Rating -->
                            <div class="text-warning mb-2">

                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-half"></i>

                                <small class="text-muted ms-1">
                                    4.5
                                </small>

                            </div>


                            <!-- Price -->
                            <h5 class="text-primary fw-bold mb-3">

                                ₹@(product.Price?.ToString("N2") ?? "0.00")

                            </h5>


                            <!-- Buttons -->
                            <div class="mt-auto">

                                <div class="d-grid gap-2">

                                    <!-- Details -->
                                    <a asp-controller="Products"
                                           asp-action="Details"
                                           asp-route-id="@product.ProductId"
                                           class="btn btn-outline-primary
                                        rounded-pill fw-semibold">

                                        <i class="bi bi-eye me-1"></i>
                                        View Details

                                    </a>


                                    <!-- Add To Cart -->
                                    <form asp-controller="Cart"
                                          asp-action="AddToCart"
                                          method="post"
                                          class="m-0">

                                        <input type="hidden"
                                               name="productId"
                                               value="@product.ProductId" />

                                        <input type="hidden"
                                               name="quantity"
                                               value="1" />

                                        <button type="submit"
                                                class="btn btn-primary
                                            rounded-pill
                                            fw-semibold w-100">

                                            <i class="bi bi-cart-plus me-1"></i>
                                            Add To Cart

                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }
        }
        else
        {
            <!-- No Products -->
            <div class="col-12">

                <div class="text-center py-5">

                    <i class="bi bi-box-seam
                    display-1 text-muted"></i>

                    <h4 class="mt-3">
                        No Products Found
                    </h4>

                    <p class="text-muted">
                        We couldn't find any products matching your search.
                    </p>

                    <a asp-controller="Products"
                           asp-action="Index"
                           class="btn btn-primary rounded-pill px-4">

                        View All Products

                    </a>

                </div>

            </div>
        }

    </div>


    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="d-flex flex-column
            flex-md-row
            justify-content-between
            align-items-center mt-5">

            <!-- Page Information -->
            <div class="text-muted mb-3 mb-md-0">
                Showing page
                <strong>@Model.PageNumber</strong>
                of
                <strong>@Model.TotalPages</strong>
            </div>

            <!-- Pagination -->
            <nav aria-label="Product pagination">

                <ul class="pagination mb-0">

                    <!-- Previous -->
                    <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">

                        <a class="page-link"
                               asp-controller="Home"
                               asp-action="Index"
                               asp-route-page="@(Model.PageNumber - 1)">

                            <i class="bi bi-chevron-left"></i>
                        </a>

                    </li>

                    <!-- Page Numbers -->
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(Model.PageNumber == i ? "active" : "")">

                            <a class="page-link"
                                   asp-controller="Home"
                                   asp-action="Index"
                                   asp-route-page="@i">

                                @i

                            </a>

                        </li>
                    }

                    <!-- Next -->
                    <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">

                        <a class="page-link"
                               asp-controller="Home"
                               asp-action="Index"
                               asp-route-page="@(Model.PageNumber + 1)">

                            <i class="bi bi-chevron-right"></i>

                        </a>

                    </li>

                </ul>

            </nav>

        </div>
    }

</div>


<style>

    .product-card {
        border-radius: 15px;
        overflow: hidden;
        transition: all 0.3s ease;
    }

        .product-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15) !important;
        }

    .product-image {
        width: 100%;
        height: 230px;
        object-fit: contain;
        padding: 15px;
        transition: transform 0.3s ease;
        cursor: pointer;
    }

    .product-card:hover .product-image {
        transform: scale(1.05);
    }

    .pagination .page-link {
        border-radius: 8px;
        margin: 0 3px;
        min-width: 40px;
        text-align: center;
    }

    .pagination .page-item.active .page-link {
        font-weight: 600;
    }

</style>
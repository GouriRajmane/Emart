@model List<EMart.Models.Brands>

<div class="container mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">
            Top Brands
        </h2>

        <a asp-controller="Brands"
               asp-action="Index"
               class="btn btn-outline-primary">
            View All
        </a>
    </div>

    <div class="row g-4">

        @foreach (var brand in Model.Where(x => x.IsActive))
        {
            <div class="col-6 col-md-4 col-lg-2">

                <div class="card shadow-sm border-0 h-100 text-center">

                    <div class="card-body d-flex flex-column align-items-center justify-content-center">

                        @if (!string.IsNullOrEmpty(brand.LogoPath))
                        {
                            <img src="@brand.LogoPath"
                                 alt="@brand.BrandName"
                                 class="img-fluid"
                                 style="width:120px; height:80px; object-fit:contain;" />
                        }
                        else
                        {
                            <div style="width:120px; height:80px;"
                                 class="d-flex align-items-center justify-content-center">

                                <i class="bi bi-building fs-1 text-secondary"></i>

                            </div>
                        }

                        <h6 class="fw-semibold mt-3 mb-0">
                            @brand.BrandName
                        </h6>

                    </div>

                </div>

            </div>
        }

    </div>

</div>
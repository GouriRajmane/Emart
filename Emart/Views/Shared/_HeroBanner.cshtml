<!-- Hero Banner -->
<div id="heroCarousel" class="carousel slide carousel-fade mb-5 shadow-sm" data-bs-ride="carousel">

    <!-- Indicators -->
    <div class="carousel-indicators">
        <button type="button"
                data-bs-target="#heroCarousel"
                data-bs-slide-to="0"
                class="active"></button>

        <button type="button"
                data-bs-target="#heroCarousel"
                data-bs-slide-to="1"></button>

        <button type="button"
                data-bs-target="#heroCarousel"
                data-bs-slide-to="2"></button>
    </div>

    <div class="carousel-inner">

        <!-- Slide 1 -->
        <div class="carousel-item active bg-primary text-white">

            <div class="container">

                <div class="row align-items-center" style="min-height:450px;">

                    <div class="col-lg-6">

                        <span class="badge bg-warning text-dark mb-3 px-3 py-2">
                            MEGA SALE
                        </span>

                        <h1 class="display-4 fw-bold">
                            Up To 50% OFF
                        </h1>

                        <p class="lead mt-3">
                            Discover the latest Electronics, Mobiles,
                            Fashion and Home Appliances at unbeatable prices.
                        </p>

                        <a asp-controller="Products"
                               asp-action="Index"
                               class="btn btn-light btn-lg mt-3 px-4">
                            <i class="bi bi-bag-fill"></i>
                            Shop Now
                        </a>

                    </div>

                    <div class="col-lg-6 text-center">

                        <img src="~/images/banners/banner1.jpg"
                             class="img-fluid"
                             style="max-height:380px;"
                             asp-append-version="true"
                             alt="Banner">

                    </div>

                </div>

            </div>

        </div>

        <!-- Slide 2 -->
        <div class="carousel-item bg-dark text-white">

            <div class="container">

                <div class="row align-items-center" style="min-height:450px;">

                    <div class="col-lg-6">

                        <span class="badge bg-danger mb-3 px-3 py-2">
                            NEW ARRIVAL
                        </span>

                        <h1 class="display-4 fw-bold">
                            Latest Smartphones
                        </h1>

                        <p class="lead mt-3">
                            Experience flagship performance with exciting launch offers.
                        </p>

                        <a asp-controller="Products"
                               asp-action="Index"
                               class="btn btn-warning btn-lg mt-3 px-4">
                            Explore Now
                        </a>

                    </div>

                    <div class="col-lg-6 text-center">

                        <img src="~/images/banners/banner2.jpg"
                             class="img-fluid"
                             style="max-height:380px;"
                             asp-append-version="true"
                             alt="Banner">

                    </div>

                </div>

            </div>

        </div>

        <!-- Slide 3 -->
        <div class="carousel-item bg-success text-white">

            <div class="container">

                <div class="row align-items-center" style="min-height:450px;">

                    <div class="col-lg-6">

                        <span class="badge bg-light text-success mb-3 px-3 py-2">
                            LIMITED OFFER
                        </span>

                        <h1 class="display-4 fw-bold">
                            Shop Your Favourite Brands
                        </h1>

                        <p class="lead mt-3">
                            Apple, Samsung, Sony, HP, Dell, LG and many more.
                        </p>

                        <a asp-controller="Products"
                               asp-action="Index"
                               class="btn btn-light btn-lg mt-3 px-4">
                            Shop Brands
                        </a>

                    </div>

                    <div class="col-lg-6 text-center">

                        <img src="~/images/banners/banner3.jpg"
                             class="img-fluid"
                             style="max-height:380px;"
                             asp-append-version="true"
                             alt="Banner">

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Previous -->
    <button class="carousel-control-prev"
            type="button"
            data-bs-target="#heroCarousel"
            data-bs-slide="prev">

        <span class="carousel-control-prev-icon"></span>

    </button>

    <!-- Next -->
    <button class="carousel-control-next"
            type="button"
            data-bs-target="#heroCarousel"
            data-bs-slide="next">

        <span class="carousel-control-next-icon"></span>

    </button>

</div>
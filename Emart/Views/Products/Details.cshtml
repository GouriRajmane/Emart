    <script>
        $("#cartForm").submit(function (e) {

            e.preventDefault();

            $.ajax({

                url: "/Cart/AddToCart",

                type: "POST",

                data: $(this).serialize(),

                success: function (response) {

                    if (response.success) {

                        $("#cartCount").text(response.cartCount);

                        alert(response.message);

                    } else {

                        alert(response.message);

                    }

                },

                error: function () {

                    alert("Something went wrong.");

                }

            });

        });
    </script>
}


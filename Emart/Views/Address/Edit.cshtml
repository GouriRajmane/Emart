@model EMart.Models.Addresses

@{
    ViewData["Title"] = "Edit Address";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-header bg-white border-0 p-4">

                    <h4 class="fw-bold mb-1">

                        <i class="bi bi-pencil-square text-primary me-2"></i>

                        Edit Delivery Address

                    </h4>

                    <p class="text-muted mb-0">
                        Update your delivery address.
                    </p>

                </div>


                <div class="card-body p-4">

                    <form asp-action="Edit"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="AddressId" />


                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <div class="form-floating mb-3">

                            <textarea asp-for="AddressLine1"
                                      class="form-control"
                                      placeholder="Address"
                                      style="height:120px;"></textarea>

                            <label asp-for="AddressLine1">
                                Address
                            </label>

                            <span asp-validation-for="AddressLine1"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="row g-3">

                            <div class="col-md-6">

                                <div class="form-floating">

                                    <input asp-for="City"
                                           class="form-control"
                                           placeholder="City" />

                                    <label asp-for="City">
                                        City
                                    </label>

                                    <span asp-validation-for="City"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <div class="col-md-6">

                                <div class="form-floating">

                                    <input asp-for="State"
                                           class="form-control"
                                           placeholder="State" />

                                    <label asp-for="State">
                                        State
                                    </label>

                                    <span asp-validation-for="State"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <div class="col-md-6">

                                <div class="form-floating">

                                    <input asp-for="Pincode"
                                           class="form-control"
                                           placeholder="Pincode" />

                                    <label asp-for="Pincode">
                                        Pincode
                                    </label>

                                    <span asp-validation-for="Pincode"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                        </div>


                        <div class="d-flex justify-content-between mt-4">

                            <a asp-action="Index"
                                   class="btn btn-outline-secondary">

                                <i class="bi bi-arrow-left me-1"></i>
                                Back

                            </a>


                            <button type="submit"
                                    class="btn btn-primary px-4">

                                <i class="bi bi-check-lg me-1"></i>
                                Update Address

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
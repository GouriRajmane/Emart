@model EMart.Models.Units

@{
    ViewData["Title"] = "Edit Unit";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow border-0">

                <!-- Card Header -->
                <div class="card-header bg-warning text-dark">

                    <div class="d-flex justify-content-between align-items-center">

                        <h3 class="mb-0">
                            <i class="bi bi-pencil-square"></i>
                            Edit Unit
                        </h3>

                        <a asp-action="Index" class="btn btn-dark btn-sm">
                            <i class="bi bi-arrow-left"></i>
                            Back
                        </a>

                    </div>

                </div>

                <form asp-action="Edit" method="post">

                    <input asp-for="UnitId" type="hidden" />

                    <div class="card-body">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>

                        <div class="row">

                            <!-- Unit Name -->

                            <div class="col-md-6 mb-3">

                                <label asp-for="UnitName"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="UnitName"
                                       class="form-control"
                                       placeholder="Enter Unit Name" />

                                <span asp-validation-for="UnitName"
                                      class="text-danger">
                                </span>

                            </div>

                            <!-- Short Name -->

                            <div class="col-md-6 mb-3">

                                <label asp-for="UnitShortName"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="UnitShortName"
                                       class="form-control"
                                       placeholder="Ex. Kg, Pc, Box" />

                                <span asp-validation-for="UnitShortName"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                        <div class="row">

                            <div class="col-md-4">

                                <div class="form-check form-switch mt-2">

                                    <input asp-for="IsActive"
                                           class="form-check-input" />

                                    <label asp-for="IsActive"
                                           class="form-check-label">
                                    </label>

                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- Footer -->

                    <div class="card-footer text-end">

                        <button type="submit"
                                class="btn btn-warning">

                            <i class="bi bi-save"></i>

                            Update

                        </button>

                        <a asp-action="Index"
                               class="btn btn-secondary">

                            <i class="bi bi-x-circle"></i>

                            Cancel

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

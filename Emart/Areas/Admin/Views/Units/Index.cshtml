@model IEnumerable<EMart.Models.Units>

@{
    ViewData["Title"] = "Units";
}

<div class="container-fluid mt-4">

    <div class="card shadow-lg border-0">

        <!-- Header -->
        <div class="card-header bg-primary text-white">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h3 class="mb-0">
                        <i class="bi bi-rulers"></i> Unit List
                    </h3>
                    <small>Manage Product Units</small>
                </div>

                <div>
                    <a asp-action="Create" class="btn btn-light">
                        <i class="bi bi-plus-circle"></i> Add New Unit
                    </a>
                </div>

            </div>

        </div>

        <!-- Body -->

        <div class="card-body">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">

                    <i class="bi bi-check-circle"></i>

                    @TempData["Success"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle" id="tblUnits">

                    <thead class="table-dark">

                        <tr>

                            <th width="70">#</th>

                            <th>Unit Name</th>

                            <th>Short Name</th>

                            <th width="120">Status</th>

                            <th width="220" class="text-center">
                                Action
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @{
                            int sr = 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@sr</td>

                                <td>

                                    <strong>
                                        @item.UnitName
                                    </strong>

                                </td>

                                <td>

                                    @item.UnitShortName

                                </td>

                                <td>

                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">

                                            Active

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">

                                            Inactive

                                        </span>
                                    }

                                </td>

                                <td class="text-center">

                                    <a asp-action="Details"
                                           asp-route-id="@item.UnitId"
                                           class="btn btn-info btn-sm">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                    <a asp-action="Edit"
                                           asp-route-id="@item.UnitId"
                                           class="btn btn-warning btn-sm">

                                        <i class="bi bi-pencil-square"></i>

                                    </a>

                                    <a asp-action="Delete"
                                           asp-route-id="@item.UnitId"
                                           class="btn btn-danger btn-sm">

                                        <i class="bi bi-trash"></i>

                                    </a>

                                </td>

                            </tr>

                            sr++;
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <script>

        $(document).ready(function () {

            $('#tblUnits').DataTable({

                responsive: true,

                pageLength: 10,

                lengthMenu: [[10,25,50,100], [10,25,50,100]]

            });

        });

    </script>
}

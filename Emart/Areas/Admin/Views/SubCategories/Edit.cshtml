@model EMart.Models.SubCategories

@{
    ViewData["Title"] = "Edit Sub Category";
}

<div class="container-fluid mt-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h3 class="fw-bold mb-0">
                <i class="bi bi-pencil-square text-warning"></i>
                Edit Sub Category
            </h3>
            <small class="text-muted">
                Dashboard / Masters / Sub Categories / Edit
            </small>
        </div>

        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle"></i>
            Back to List
        </a>

    </div>

    <div class="card shadow-sm border-0">

        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0">
                <i class="bi bi-pencil"></i>
                Update Sub Category
            </h5>
        </div>

        <div class="card-body">

            <form asp-action="Edit" method="post">

                <input type="hidden" asp-for="SubCategoryId" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="row">

                    <!-- Category -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="CategoryId"
                               class="form-label fw-semibold">
                            Category
                        </label>

                        <select asp-for="CategoryId"
                                asp-items="ViewBag.CategoryList"
                                class="form-select">

                            <option value="">-- Select Category --</option>

                        </select>

                        <span asp-validation-for="CategoryId"
                              class="text-danger"></span>

                    </div>

                    <!-- Sub Category -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="SubCategoryName"
                               class="form-label fw-semibold">
                            Sub Category Name
                        </label>

                        <input asp-for="SubCategoryName"
                               class="form-control"
                               placeholder="Enter Sub Category Name" />

                        <span asp-validation-for="SubCategoryName"
                              class="text-danger"></span>

                    </div>

                </div>

                <div class="row">

                    <!-- Status -->

                    <div class="col-md-6 mb-3">

                        <div class="form-check mt-4">

                            <input asp-for="IsActive"
                                   class="form-check-input" />

                            <label asp-for="IsActive"
                                   class="form-check-label">
                                Active
                            </label>

                        </div>

                    </div>

                </div>

                <hr />

                <button type="submit"
                        class="btn btn-warning">

                    <i class="bi bi-check-circle"></i>
                    Update

                </button>

                <a asp-action="Index"
                   class="btn btn-danger">

                    <i class="bi bi-x-circle"></i>
                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
@model EMart.Models.Brands

@{
    ViewData["Title"] = "Brand Details";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-info text-white">
            <h3 class="mb-0">Brand Details</h3>
        </div>

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3 fw-bold">
                    @Html.DisplayNameFor(model => model.BrandId)
                </dt>

                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.BrandId)
                </dd>

                <dt class="col-sm-3 fw-bold">
                    @Html.DisplayNameFor(model => model.BrandName)
                </dt>

                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.BrandName)
                </dd>

            </dl>

        </div>

        <div class="card-footer">

            <a asp-action="Edit"
                   asp-route-id="@Model.BrandId"
                   class="btn btn-warning">
                Edit
            </a>

            <a asp-action="Index"
                   class="btn btn-secondary">
                Back to List
            </a>

        </div>

    </div>

</div>
@model EMart.Models.Brands

@{
    ViewData["Title"] = "Delete Brand";
}

<div class="container mt-4">

    <div class="card shadow border-danger">

        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">Delete Brand</h3>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">
                <h5 class="mb-0">
                    Are you sure you want to delete this brand?
                </h5>
            </div>

            <dl class="row">

                <dt class="col-sm-3 fw-bold">
                    @Html.DisplayNameFor(model => model.BrandId)
                </dt>

                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.BrandId)
                </dd>

                <dt class="col-sm-3 fw-bold">
                    @Html.DisplayNameFor(model => model.BrandName)
                </dt>

                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.BrandName)
                </dd>

            </dl>

        </div>

        <div class="card-footer">

            <form asp-action="Delete">

                <input type="hidden" asp-for="BrandId" />

                <button type="submit" class="btn btn-danger">
                    Delete
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>
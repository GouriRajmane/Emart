@model EMart.Models.Brands

@{
    ViewData["Title"] = "Create Brand";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-success text-white">
            <h3 class="mb-0">Create Brand</h3>
        </div>

        <div class="card-body">

            <form asp-action="Create" method="post" enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="BrandName" class="form-label"></label>
                    <input asp-for="BrandName"
                           class="form-control"
                           placeholder="Enter Brand Name" />
                    <span asp-validation-for="BrandName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Brand Logo</label>

                    <input type="file"
                           name="LogoFile"
                           class="form-control"
                           accept="image/*" />
                </div>

                <div class="mt-4">

                    <button type="submit" class="btn btn-success">
                        Save
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}   
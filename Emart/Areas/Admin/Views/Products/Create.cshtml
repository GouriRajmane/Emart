@model EMart.ViewModels.ProductVM

@{
    ViewData["Title"] = "Create Product";
}

<div class="container-fluid mt-4">

    <form asp-action="Create"
          method="post"
          enctype="multipart/form-data">

        <div class="card shadow border-0">

            <div class="card-header bg-primary text-white">

                <div class="d-flex justify-content-between align-items-center">

                    <h3 class="mb-0">
                        <i class="bi bi-box-seam"></i>
                        Add New Product
                    </h3>

                    <a asp-action="Index"
                           class="btn btn-light">

                        <i class="bi bi-arrow-left"></i>

                        Back

                    </a>

                </div>

            </div>

            <div class="card-body">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="row">

                    <!-- SKU -->

                    <div class="col-md-4 mb-3">

                        <label asp-for="Product.SKU"
                               class="form-label fw-bold">
                        </label>

                        <input asp-for="Product.SKU"
                               class="form-control"
                               placeholder="Enter SKU" />

                        <span asp-validation-for="Product.SKU"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Product Name -->

                    <div class="col-md-8 mb-3">

                        <label asp-for="Product.ProductName"
                               class="form-label fw-bold">
                        </label>

                        <input asp-for="Product.ProductName"
                               class="form-control"
                               placeholder="Enter Product Name" />

                        <span asp-validation-for="Product.ProductName"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="row">

                    <!-- Category -->

                    <div class="col-md-3 mb-3">

                        <label class="form-label fw-bold">

                            Category

                        </label>

                        <select asp-for="Product.CategoryId"
                                asp-items="Model.Categories"
                                class="form-select"
                                id="CategoryId">

                            <option value="">

                                -- Select Category --

                            </option>

                        </select>

                        <span asp-validation-for="Product.CategoryId"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Sub Category -->

                    <div class="col-md-3 mb-3">

                        <label class="form-label fw-bold">

                            Sub Category

                        </label>

                        <select asp-for="Product.SubCategoryId"
                                asp-items="Model.SubCategories"
                                class="form-select"
                                id="SubCategoryId">

                            <option value="">

                                -- Select Sub Category --

                            </option>

                        </select>

                        <span asp-validation-for="Product.SubCategoryId"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Brand -->

                    <div class="col-md-3 mb-3">

                        <label class="form-label fw-bold">

                            Brand

                        </label>

                        <select asp-for="Product.BrandId"
                                asp-items="Model.Brands"
                                class="form-select">

                            <option value="">

                                -- Select Brand --

                            </option>

                        </select>

                        <span asp-validation-for="Product.BrandId"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Unit -->

                    <div class="col-md-3 mb-3">

                        <label class="form-label fw-bold">

                            Unit

                        </label>

                        <select asp-for="Product.UnitId"
                                asp-items="Model.Units"
                                class="form-select">

                            <option value="">

                                -- Select Unit --

                            </option>

                        </select>

                        <span asp-validation-for="Product.UnitId"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="row">

                    <!-- Price -->

                    <div class="col-md-3 mb-3">

                        <label asp-for="Product.Price"
                               class="form-label fw-bold">
                        </label>

                        <input asp-for="Product.Price"
                               class="form-control"
                               placeholder="0.00" />

                        <span asp-validation-for="Product.Price"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Quantity -->

                    <div class="col-md-3 mb-3">

                        <label asp-for="Product.Quantity"
                               class="form-label fw-bold">
                        </label>

                        <input asp-for="Product.Quantity"
                               class="form-control"
                               placeholder="0" />

                        <span asp-validation-for="Product.Quantity"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Status -->

                    <div class="col-md-3 mb-3 d-flex align-items-center">

                        <div class="form-check form-switch mt-4">

                            <input asp-for="Product.IsActive"
                                   class="form-check-input" />

                            <label asp-for="Product.IsActive"
                                   class="form-check-label">
                            </label>

                        </div>

                    </div>

                </div>

                <!-- Description -->

                <div class="row">

                    <div class="col-md-12 mb-3">

                        <label asp-for="Product.Description"
                               class="form-label fw-bold">
                        </label>

                        <textarea asp-for="Product.Description"
                                  rows="5"
                                  class="form-control"
                                      placeholder="Enter Product Description">
                        </textarea>

                            <span asp-validation-for="Product.Description"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                    <hr />

                    <div class="row mt-4">

                        <div class="col-md-12">

                            <h5 class="mb-3">
                                <i class="bi bi-images"></i>
                                Product Images
                            </h5>

                        </div>

                        <div class="col-md-12 mb-3">

                            <label asp-for="Images" class="form-label fw-bold"></label>

                            <input asp-for="Images"
                                   id="ImageUpload"
                                   class="form-control"
                                   type="file"
                                   multiple
                                   accept="image/*" />

                            <span asp-validation-for="Images"
                                  class="text-danger"></span>

                            <small class="text-muted">
                                Select one or more images.
                            </small>

                        </div>

                    </div>

                    <div class="row" id="imagePreview"></div>

                </div>

                <div class="card-footer text-end">

                    <button type="submit"
                            class="btn btn-success">

                        <i class="bi bi-check-circle"></i>

                        Save Product

                    </button>

                    <a asp-action="Index"
                           class="btn btn-secondary">

                        Cancel

                    </a>

                </div>

            </div>

        </form>

    </div>

    @section Scripts
    {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }

        <script>

            document.getElementById("ImageUpload").addEventListener("change", function () {

                let preview = document.getElementById("imagePreview");

                preview.innerHTML = "";

                Array.from(this.files).forEach(file => {

                    if (!file.type.startsWith("image/"))
                        return;

                    let reader = new FileReader();

                    reader.onload = function (e) {

                        preview.innerHTML += `
                            <div class="col-md-3 mb-3">
                                <div class="card">
                                    <img src="${e.target.result}"
                                         class="card-img-top"
                                         style="height:180px;object-fit:cover;">
                                    <div class="card-footer text-center">
                                        <small>${file.name}</small>
                                    </div>
                                </div>
                            </div>`;
                    };

                    reader.readAsDataURL(file);

                });

            });

        </script>
    }